<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Default background color for the splash screen -->
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <!-- The icon to display in the center of the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_dynamic</item>
        <!-- The theme to use after the splash screen is dismissed -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
